{
  "package_name": "Zaskaleta MASTER CLONE",
  "version": "v1",
  "status": "development",
  "principle": "MASTER CLONE first. Scenes are external and must never become part of clone identity.",
  "components": {
    "identity": {
      "canonical_anchor": "MVIMG_20260830_144834.jpg",
      "supporting_reference_count": 5,
      "lock": [
        "exact facial structure",
        "natural asymmetry",
        "eye shape",
        "nose",
        "lips",
        "jaw",
        "beard shape density and color",
        "hairstyle and hairline",
        "age",
        "skin tone",
        "stable identity across frontal, profile and 3/4 views"
      ],
      "forbidden": [
        "beautification",
        "rejuvenation",
        "face reshaping",
        "face swap",
        "lookalike substitution",
        "scene-to-scene identity switching",
        "AI-generated rejected frames as identity references"
      ]
    },
    "motion": {
      "profile": "Zaskaleta Motion Profile v1",
      "learning_profile": "content/motion_learning_profile_v1.json",
      "learning_engine": "MMPose 1.1.0",
      "primary_reference": "MASTER_BEHAVIOR_01.mp4",
      "supporting_reference": "MASTER_BEHAVIOR_02.mp4",
      "auto_discovery_glob": "MASTER_BEHAVIOR_*.mp4",
      "presets": [
        "neutral",
        "talking_calm",
        "talking_confident",
        "slight_head_turn",
        "subtle_gesture",
        "natural_blink",
        "breathing",
        "shoulder_movement",
        "walking",
        "sitting",
        "standing",
        "hand_gesture",
        "emotional_reaction",
        "presentation_style"
      ],
      "extract_only": [
        "head movement",
        "blinking",
        "eye micro-movements",
        "shoulder motion",
        "neck motion",
        "breathing",
        "body rhythm",
        "talking behavior",
        "posture",
        "gesture rhythm",
        "normalized body keypoints",
        "relative joint trajectories",
        "movement speed and timing"
      ],
      "ignore": [
        "background",
        "room",
        "bed",
        "captions",
        "watermark",
        "scene",
        "wardrobe as identity",
        "source person's face identity",
        "source person's voice"
      ],
      "learning_policy": {
        "auto_training": false,
        "manual_approval_required": true,
        "identity_independent": true,
        "approved_motion_only": true
      }
    },
    "talking": {
      "engine": "MuseTalk 1.5",
      "required_behaviors": [
        "jaw motion",
        "cheek motion",
        "mouth articulation",
        "natural blink during speech",
        "head micro-motion",
        "eye behavior",
        "pause-aware expression",
        "sentence-end facial relaxation",
        "speaking rhythm"
      ]
    },
    "voice": {
      "master": "Zaskaleta_AI_Voice_Master.mp3",
      "language": "uk",
      "base_tts": "facebook/mms-tts-ukr",
      "voice_conversion": "OpenVoice V2",
      "presets": [
        "calm",
        "confident",
        "serious",
        "warm",
        "motivational",
        "conversational"
      ],
      "targets": [
        "natural sentence intonation",
        "soft pauses",
        "non-monotone phrase rhythm",
        "natural emotional dynamics",
        "speech that feels produced by the visible speaker"
      ]
    }
  },
  "reference_policy": {
    "approved": [
      "real photos",
      "real videos",
      "real voice",
      "manually approved good generations",
      "manually approved identity-independent motion profiles"
    ],
    "rejected": [
      "face drift",
      "wrong beard",
      "wrong age",
      "wrong mouth",
      "wrong jaw",
      "unnatural motion",
      "wrong identity",
      "ambiguous or low-confidence motion extraction"
    ],
    "rule": "Never auto-train on all generated outputs. Only APPROVED material may become future reference material."
  },
  "improvement_lifecycle": {
    "stable_release_is_immutable": true,
    "candidate_quarantine_required": true,
    "manual_promotion_required": true,
    "holdout_regression_set": true,
    "single_component_change_preferred": true,
    "required_lineage": [
      "clone_version",
      "code_commit",
      "model_versions",
      "input_reference_ids",
      "prompt_or_script",
      "voice_preset",
      "motion_preset",
      "generation_timestamp",
      "quality_evaluation"
    ],
    "promotion_rule": "A challenger version may become stable only after passing every mandatory gate and showing no identity regression versus the current stable release.",
    "rollback_rule": "Never overwrite a stable release in place. Keep prior release manifests and assets addressable for immediate rollback.",
    "generated_data_rule": "Generated material enters training/reference pools only after explicit APPROVED review. REJECTED material is permanently excluded from promotion datasets."
  },
  "evaluation_dimensions": [
    "identity consistency",
    "face drift",
    "beard and hair consistency",
    "lip-sync naturalness",
    "jaw and cheek motion",
    "blink and eye behavior",
    "head micro-motion",
    "voice similarity and naturalness",
    "speech intelligibility",
    "audio-video sync",
    "duration correctness",
    "motion naturalness"
  ],
  "test_gates": [
    {"stage":"8-15s","advance_when":["identity stable","lip-sync natural","voice natural","motion natural","no face drift"]},
    {"stage":"15-30s","advance_when":["identity stable","lip-sync natural","voice natural","motion natural","no face drift"]},
    {"stage":"30-45s","advance_when":["identity stable","lip-sync natural","voice natural","motion natural","no face drift"]},
    {"stage":"45-60s","advance_when":["identity stable","lip-sync natural","voice natural","motion natural","no face drift"]},
    {"stage":"60-90s","advance_when":["identity stable","lip-sync natural","voice natural","motion natural","no face drift"]}
  ],
  "folder_layout": [
    "MASTER_CLONE/IDENTITY",
    "MASTER_CLONE/MOTION",
    "MASTER_CLONE/MOTION/CANDIDATES",
    "MASTER_CLONE/MOTION/APPROVED",
    "MASTER_CLONE/MOTION/REJECTED",
    "MASTER_CLONE/TALKING",
    "MASTER_CLONE/VOICE",
    "MASTER_CLONE/CANDIDATES",
    "MASTER_CLONE/EVALUATIONS",
    "MASTER_CLONE/TRAINING_SETS",
    "MASTER_CLONE/APPROVED",
    "MASTER_CLONE/REJECTED",
    "MASTER_CLONE/VERSIONS",
    "MASTER_CLONE/RELEASES"
  ],
  "scene_independence": {
    "scene": "external",
    "background": "external",
    "location": "external",
    "wardrobe": "external unless explicitly locked per production",
    "captions": "external",
    "watermark": "external"
  }
}
