{
  "schema": "zaskaleta-storage-v2",
  "canonical_storage": {
    "provider": "s3_compatible",
    "role": "MASTER_CLONE canonical storage",
    "required_region_policy": "EU_ONLY",
    "required_server_side_encryption": true,
    "required_client_side_encryption_for_biometrics": true,
    "object_lock_preferred": true,
    "versioning_required": true,
    "bucket_env": "AI_TWIN_STORAGE_BUCKET",
    "endpoint_env": "AI_TWIN_STORAGE_ENDPOINT",
    "region_env": "AI_TWIN_STORAGE_REGION",
    "access_key_env": "AI_TWIN_STORAGE_ACCESS_KEY_ID",
    "secret_key_env": "AI_TWIN_STORAGE_SECRET_ACCESS_KEY",
    "migration_manifest_key": "MASTER_CLONE/MEMORY/storage_migration_manifest_v1.json",
    "job_artifact_prefix": "MASTER_CLONE/TESTS/JOBS",
    "layout": [
      "MASTER_CLONE/IDENTITY",
      "MASTER_CLONE/MOTION",
      "MASTER_CLONE/TALKING",
      "MASTER_CLONE/VOICE",
      "MASTER_CLONE/MEMORY",
      "MASTER_CLONE/CANDIDATES",
      "MASTER_CLONE/APPROVED",
      "MASTER_CLONE/REJECTED",
      "MASTER_CLONE/EVALUATIONS",
      "MASTER_CLONE/VERSIONS",
      "MASTER_CLONE/RELEASES",
      "MASTER_CLONE/TESTS",
      "MASTER_CLONE/FINAL"
    ]
  },
  "provider_profiles": {
    "hetzner_object_storage": {
      "protocol": "s3",
      "status": "preferred",
      "region_policy": "EU_ONLY",
      "notes": "Recommended primary provider when configured by the user. Credentials must be supplied only through runtime environment variables."
    },
    "cloudflare_r2": {
      "protocol": "s3",
      "status": "supported",
      "region_policy": "EU_ONLY",
      "notes": "Supported fallback provider. Use an EU-jurisdiction bucket when configured."
    },
    "minio": {
      "protocol": "s3",
      "status": "supported",
      "region_policy": "USER_CONTROLLED",
      "notes": "Suitable for self-hosted/local NAS backup or private infrastructure."
    }
  },
  "backup_policy": {
    "minimum_independent_copies": 2,
    "primary_and_backup_must_not_share_credentials": true,
    "recommended_secondary": "encrypted local NAS/SSD or a second S3-compatible provider",
    "verify_restore_regularly": true
  },
  "encryption": {
    "biometric_assets": ["identity_photos", "voice_master", "behavior_video", "approved_identity_outputs"],
    "client_side_encryption_required": true,
    "key_material_must_not_be_stored_with_objects": true,
    "key_env": "AI_TWIN_DATA_ENCRYPTION_KEY",
    "never_commit_keys": true
  },
  "legacy_source_import": {
    "provider": "google_drive",
    "folder_id": "13Wye5lVZPOcUryXbXhplad_FkxM7lG4a",
    "role": "legacy/source import only",
    "write_back": false,
    "production_dependency": false
  },
  "legacy_canonical_migration": {
    "provider": "google_drive",
    "folder_id": "1_7G-rAGQ80Vpe_CWdGOzPIg0nuprDp3s",
    "role": "migration source only until verified cutover",
    "write_back": false,
    "production_dependency": false
  },
  "runtime": {
    "preferred_backend": "runpod",
    "local_mount": "/workspace/zaskaleta-storage",
    "storage_credentials": "server-side environment variables only",
    "temporary_worker_cache_allowed": true,
    "job_scoped_plaintext_materialization_required": true,
    "delete_temporary_plaintext_after_job": true,
    "runtime_attestation_required": true,
    "never_commit_credentials": true,
    "never_commit_private_biometric_media": true
  }
}
